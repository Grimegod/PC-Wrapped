{
  "name": "pc-wrapped",
  "version": "1.1.0",
  "private": true,
  "author": "PCWrapped",
  "description": "A private, local-only activity recap for Windows",
  "main": "dist/src/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "check:deps": "node scripts/check-deps.cjs",
    "check:identity": "node scripts/check-identity.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.cjs\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.cjs\" \"*.json\" \"*.md\"",
    "build:ts": "node scripts/build-ts.cjs",
    "dev": "node scripts/build-ts.cjs && electron .",
    "start": "electron .",
    "test": "node scripts/generate-conversions.cjs && tsx --test tests/*.test.ts",
    "test:preview": "node scripts/build-ts.cjs && electron scripts/preview-smoke-app && node scripts/check-preview-smoke.cjs",
    "build:portable": "node scripts/build-ts.cjs && electron-builder --win portable",
    "build:msix": "node scripts/build-ts.cjs && node scripts/check-identity.cjs && node node_modules/electron-builder/cli.js --win msix --config.asar=false --config.electronFuses.onlyLoadAppFromAsar=false && node scripts/check-msix-layout.cjs release/win-unpacked",
    "verify": "node scripts/check-deps.cjs && node scripts/check-identity.cjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && node scripts/generate-conversions.cjs && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^24.10.0",
    "electron": "^39.2.7",
    "electron-builder": "27.0.0-alpha.14",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.16.0"
  },
  "build": {
    "appId": "com.grimegod.pcwrapped",
    "productName": "PCWrapped",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "fileOptions": {
      "files": [
        "dist/**/*",
        "assets/**/*",
        "package.json"
      ],
      "extraResources": [
        {
          "from": "scripts/tracker.ps1",
          "to": "tracker.ps1"
        },
        {
          "from": "assets/pc-wrapped.ico",
          "to": "pc-wrapped.ico"
        },
        {
          "from": "assets/pc-wrapped-tray.png",
          "to": "pc-wrapped-tray.png"
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "assets/pc-wrapped.ico",
      "target": [
        "portable",
        "msix"
      ],
      "artifactName": "PC-Wrapped-${version}-${arch}.${ext}"
    },
    "msix": {
      "applicationId": "PCWrapped",
      "identityName": "PaulGrimu.PCWrapped",
      "publisher": "CN=077C1390-8C9F-4DBE-AD6E-C01D348FB24D",
      "publisherDisplayName": "Paul Grimu",
      "displayName": "PCWrapped",
      "backgroundColor": "#fff7ef",
      "showNameOnTiles": true,
      "createMsixupload": true,
      "addAutoLaunchExtension": false
    },
    "portable": {
      "artifactName": "PC-Wrapped-${version}-portable-${arch}.${ext}"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    }
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "publicHoistPattern": [
      "app-builder-lib",
      "builder-util",
      "builder-util-runtime",
      "@electron/asar",
      "chalk"
    ]
  }
}
